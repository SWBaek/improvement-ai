{
  "spec": "human-review-artifacts/interaction-catalog@0.1",
  "patterns": [
    {"name":"orient","version":"0.1","intent":"Understand scope, state and limits","requiredComponents":["context-overview","response-panel"],"allowedActions":["acknowledge","comment"]},
    {"name":"compare","version":"0.1","intent":"Evaluate alternatives using shared criteria","requiredComponents":["option-comparison","response-panel"],"allowedActions":["select","rank","comment","defer"]},
    {"name":"decide","version":"0.1","intent":"Commit, reject, defer or request changes","requiredComponents":["decision-panel","evidence-list","response-panel"],"allowedActions":["select","approve","reject","request-changes","defer","comment"]},
    {"name":"revise","version":"0.1","intent":"Confirm that feedback was incorporated","requiredComponents":["change-diff","response-panel"],"allowedActions":["approve","request-changes","comment","defer"]},
    {"name":"verify","version":"0.1","intent":"Judge results against explicit criteria","requiredComponents":["verification-results","evidence-list","response-panel"],"allowedActions":["approve","reject","challenge","comment","defer"]}
  ]
}
