{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swbaek:human-review-artifacts:review-response:0.1",
  "title": "Human Review Artifacts Review Response 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "artifact", "createdAt", "responses"],
  "properties": {
    "spec": { "const": "human-review-artifacts/review-response@0.1" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "spec", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "spec": { "const": "human-review-artifacts/core@0.2" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "disposition"],
        "properties": {
          "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "disposition": {
            "enum": ["acknowledged", "commented", "selected", "approved", "rejected", "changes-requested", "deferred"]
          },
          "selectionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "comment": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "extensions": { "type": "object" }
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
