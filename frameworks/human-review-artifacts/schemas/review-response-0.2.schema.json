{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swbaek:human-review-artifacts:review-response:0.2",
  "title": "Human Review Artifacts Review Response 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "artifact", "interaction", "createdAt", "responses"],
  "properties": {
    "spec": { "const": "human-review-artifacts/review-response@0.2" },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["id", "spec", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "spec": { "const": "human-review-artifacts/core@0.3" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false, "required": ["pattern"],
      "properties": {
        "pattern": {
          "type": "object", "additionalProperties": false, "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "responses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["targetId", "action"],
        "properties": {
          "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "action": { "enum": ["acknowledge", "answer", "comment", "select", "rank", "approve", "reject", "request-changes", "defer", "challenge"] },
          "selectionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "rankingIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "comment": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "extensions": { "type": "object" }
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
