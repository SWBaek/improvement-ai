{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swbaek:human-review-artifacts:manifest:0.1",
  "title": "Human Review Artifacts Core Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "id",
    "title",
    "status",
    "language",
    "createdAt",
    "updatedAt",
    "review",
    "profiles",
    "provenance"
  ],
  "properties": {
    "spec": {
      "const": "human-review-artifacts/core@0.1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": ["draft", "in-review", "accepted", "superseded", "archived"]
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["inform", "comment", "decide", "approve"]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {
          "enum": ["human", "ai-assisted", "ai-generated"]
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{7,64}$"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
