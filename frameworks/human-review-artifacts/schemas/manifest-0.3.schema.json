{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swbaek:human-review-artifacts:manifest:0.3",
  "title": "Human Review Artifacts Core Manifest 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "id", "revision", "title", "status", "language", "createdAt", "updatedAt", "interaction", "profiles", "provenance"],
  "properties": {
    "spec": { "const": "human-review-artifacts/core@0.3" },
    "id": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["draft", "in-review", "accepted", "superseded", "archived"] },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "prompt", "targets"],
      "properties": {
        "pattern": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          }
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "required", "allowedActions"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
              "required": { "type": "boolean" },
              "allowedActions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["acknowledge", "answer", "comment", "select", "rank", "approve", "reject", "request-changes", "defer", "challenge"] }
              }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": { "enum": ["human", "ai-assisted", "ai-generated"] },
        "tool": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9A-Fa-f]{7,64}$" },
        "generator": {
          "type": "object", "additionalProperties": false, "required": ["name", "version"],
          "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 }, "version": { "type": "string", "minLength": 1, "maxLength": 50 } }
        },
        "inputs": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "digest"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "digest": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]{43}=$" },
              "schema": { "type": "string", "minLength": 1, "maxLength": 200 },
              "uri": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["scripts"],
      "properties": {
        "scripts": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "owner", "version", "digest"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
              "owner": { "enum": ["core", "profile"] },
              "profile": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
              "digest": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]{43}=$" }
            }
          }
        }
      }
    },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "additionalProperties": { "type": "object" } }
  }
}
