{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:improvement-ai:manage-focus-cycle:workspace-input:1",
  "title": "Focus Cycle Workspace Input",
  "type": "object",
  "required": [
    "schemaVersion",
    "language",
    "updatedAt",
    "durableRecord",
    "project",
    "cycle",
    "contract",
    "discussion",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "language": { "type": "string", "minLength": 2, "maxLength": 35 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "durableRecord": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "required": ["name", "purpose", "workstreams"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "workstreams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "state", "detail"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["context", "deferred", "blocking"] },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "cycle": {
      "type": "object",
      "required": [
        "title",
        "status",
        "mode",
        "objective",
        "whyNow",
        "primaryBlocker",
        "readiness",
        "scope",
        "progress"
      ],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["Proposed", "Active", "Blocked", "Ready to Close", "Closed"] },
        "mode": { "type": "string", "enum": ["delivery", "maintenance", "research", "decision"] },
        "objective": { "type": "string", "minLength": 1 },
        "whyNow": { "type": "string", "minLength": 1 },
        "primaryBlocker": { "type": "string", "minLength": 1 },
        "readiness": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "required": ["in", "out"],
          "additionalProperties": false,
          "properties": {
            "in": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "out": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "progress": {
          "type": "object",
          "required": ["kind", "summary", "items"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["criteria", "milestones", "release-health", "evidence-readiness", "decision-readiness"] },
            "summary": { "type": "string", "minLength": 1 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "state", "detail"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "state": { "type": "string", "enum": ["pending", "active", "met", "blocked", "unknown", "not-applicable"] },
                  "detail": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "required": ["criteria", "reviewBudget", "expectedOutcome", "reopenCondition"],
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "state"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["draft", "pending", "met", "blocked", "unknown", "not-applicable"] }
            }
          }
        },
        "reviewBudget": { "type": "string", "minLength": 1 },
        "expectedOutcome": { "type": "string", "minLength": 1 },
        "reopenCondition": { "type": "string", "minLength": 1 }
      }
    },
    "discussion": {
      "type": "object",
      "required": ["question", "requestedDecision", "blocks"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "requestedDecision": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["paragraph", "list", "table", "mermaid"] },
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "caption": { "type": "string", "minLength": 1 },
              "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              },
              "source": { "type": "string", "minLength": 1 },
              "fallback": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "location", "revision", "observedAt", "classification"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "enum": ["observed", "inferred", "unknown", "human-confirmed"] }
        }
      }
    }
  }
}
